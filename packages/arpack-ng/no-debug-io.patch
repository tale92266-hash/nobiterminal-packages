# NobiTerminal fork fix (Wave 5 C1, 2026-11-26): the NDK r30 flang toolchain's
# libflang_rt.runtime.a is built WITHOUT -fPIC, so its formatted-I/O objects
# (utf.cpp.o, unit.cpp.o, binary-to-decimal.cpp.o) cannot link into a shared
# library (ld.lld: "recompile with -fPIC"). arpack's only formatted I/O is
# the msglvl debug timing summary in the 6 *aupd.f drivers (write(6,1000) /
# write(6,1100)); removing those 12 statements stops the linker pulling the
# non-PIC runtime objects in. Numerics untouched; only the msglvl>0 debug
# printout goes away. The -fPIC Fortran flag alone cannot fix this: it only
# covers arpack's own objects, not the toolchain's runtime archive.
# (Run 45856658514 failed on exactly these 3 archive members, 20 errors.)
diff -ruN orig/SRC/cnaupd.f patched/SRC/cnaupd.f
--- a/SRC/cnaupd.f	2026-11-26 16:31:17.005916593 +0000
+++ b/SRC/cnaupd.f	2026-11-26 16:31:17.096739786 +0000
@@ -620,10 +620,6 @@
 c        | Version Number & Version Date are defined in version.h |
 c        %--------------------------------------------------------%
 c
-         write (6,1000)
-         write (6,1100) mxiter, nopx, nbx, nrorth, nitref, nrstrt,
-     &                  tmvopx, tmvbx, tcaupd, tcaup2, tcaitr, titref,
-     &                  tgetv0, tceigh, tcgets, tcapps, tcconv, trvec
  1000    format (//,
      &      5x, '=============================================',/
      &      5x, '= Complex implicit Arnoldi update code      =',/
